    from {{ package_name }}.http.request import RequestContext

register = template.Library()


@register.inclusion_tag("cookie_banner.html", takes_context=True)
def cookie_banner(context: RequestContext) -> dict:
    """Render the GDPR cookie consent banner.

    Passes ``cookies_accepted`` into the template based on whether the
    GDPR consent cookie is present on the request.
    """
    cookies_accepted = settings.GDPR_COOKIE_NAME in context.request.COOKIES
    return context.flatten() | {"cookies_accepted": cookies_accepted}


@register.simple_tag(takes_context=True)
def title_tag(
    context: RequestContext, *elements: StrOrPromise, divider: str = " | "
) -> str:
    """Renders <title> content including the site name.

    Example:
        {% raw %}{% title_tag _("About Us") %}{% endraw %}
    Results in:
        <title>My Site | About Us</title>
    """
    content = divider.join(str(e) for e in (context.request.site.name, *elements))
    return format_html("<title>{}</title>", content)


@register.simple_tag
@functools.cache
def meta_tags() -> str:
    """Renders META tags from settings including HTMX config."""
    tags = [
        *[{"name": key, "content": value} for key, value in settings.META_TAGS.items()],
        {
            "name": "htmx-config",
            "content": json.dumps(settings.HTMX_CONFIG),
        },
    ]
    return format_html_join(
        "\n",
        "<meta {}>",
        (
            (
                format_html_join(
                    " ",
                    '{}="{}"',
                    ((key, value) for key, value in meta.items()),
                ),
            )
            for meta in tags
        ),
    )


@register.simple_tag
def absolute_uri(site: Site, path: str, *args, **kwargs) -> str:
    """Returns absolute URI for the given path."""
    scheme = "https" if settings.USE_HTTPS else "http"
    url = resolve_url(path, *args, **kwargs)
    return f"{scheme}://{site.domain}{url}"


@dataclass(frozen=True, kw_only=True)
class ActiveUrl:
    """Result of ``active_url`` and ``re_active_url`` template tags.

    Provides the resolved URL, active state, and CSS classes. Use
    ``obj.css_class`` in templates for the resolved class string, or
    access ``obj.url`` and ``obj.is_active`` independently.
    """

    url: str
    is_active: bool
    active_class: str = ""
    inactive_class: str = ""

    @property
    def css_class(self) -> str:
        """Return active_class or inactive_class based on is_active."""
        return self.active_class if self.is_active else self.inactive_class


@register.simple_tag(takes_context=True)
def active_url(
    context: RequestContext,
    viewname: str,
    *args: Any,
    active_class: str = "",
    inactive_class: str = "",
    **url_kwargs: Any,
) -> ActiveUrl:
    """Resolve a URL and return an ActiveUrl indicating whether it is current.

    Takes the same positional and keyword arguments as the ``url`` tag. Compares
    the resolved URL against ``request.path`` to determine active state.
    Use ``obj.url`` for the href and ``obj.css_class`` for the active/inactive class.

    Example:
        {% raw %}{% active_url 'account_email' active_class=active_class as match %}{% endraw %}
        {% raw %}{% active_url 'post_detail' post.pk active_class=active_class as match %}{% endraw %}
    """
    url = _resolve_url(viewname, args, url_kwargs)
    is_active = bool(url) and context.request.path == url
    return ActiveUrl(
        url=url,
        is_active=is_active,
        active_class=active_class,
        inactive_class=inactive_class,
    )


@register.simple_tag(takes_context=True)
def re_active_url(
    context: RequestContext,
    pattern: str,
    viewname: str = "",
    *args: Any,
    active_class: str = "",
    inactive_class: str = "",
    **url_kwargs: Any,
) -> ActiveUrl:
    """Match current path against a pattern and return an ActiveUrl.

    Use when a nav item should be active across multiple URL patterns. Pass
    a viewname as the second argument to resolve the href URL. Accepts the
    same positional and keyword arguments as the ``url`` tag.

    Example:
        {% raw %}{% re_active_url 'password/(change|set)' 'account_change_password' active_class=active_class as pw %}{% endraw %}
        {% raw %}{% re_active_url 'posts/\\d+' 'post_detail' post.pk active_class=active_class as pw %}{% endraw %}
        {% raw %}<a href="{{ pw.url }}" class="{{ pw.css_class }}">Password</a>{% endraw %}
    """
    url = _resolve_url(viewname, args, url_kwargs)
    is_active = bool(re.search(pattern, context.request.path))
    return ActiveUrl(
        url=url,
        is_active=is_active,
        active_class=active_class,
        inactive_class=inactive_class,
    )


@register.simple_block_tag(takes_context=True)
def fragment(
    context: Context,
    content: str,
    template_name: str,
    *,
    only: bool = False,
    **extra_context,
) -> SafeString:
    """Renders an include template with block content passed as {{ '{{ content }}' }}.

    Example:

        {% raw %}{% fragment "header.html" %}{% endraw %}
        title goes here
        {% raw %}{% endfragment %}{% endraw %}

    header.html:

        <h1>{{ '{{ content }}' }}</h1>

    If `only` is passed the outer context is not included.
    """
    context = context.new() if only else context

    if context.template is None:
        raise template.TemplateSyntaxError(
            "Can only be used inside a template context."
        )

    tmpl = context.template.engine.get_template(template_name)

    with context.push(content=content, **extra_context):
        return tmpl.render(context)


@register.simple_tag(takes_context=True)
def try_include(
    context: Context, template_name: str, fallback: str, **extra_context
) -> str:
    """Include a template, falling back to ``fallback`` if not found.

    Useful for optional per-widget overrides where a sensible default exists.
    Extra keyword arguments are pushed onto the context for the render.

    Example:

        {% raw %}{% try_include "forms/partials.html#"|add:widget_type "forms/partials.html#input" %}{% endraw %}
        {% raw %}{% try_include "tmpl_a.html" "tmpl_b.html" foo=bar %}{% endraw %}
    """
    if context.template is None:
        raise template.TemplateSyntaxError(
            "Can only be used inside a template context."
        )

    engine = context.template.engine
    try:
        tmpl = engine.get_template(template_name)
    except TemplateDoesNotExist:
        tmpl = engine.get_template(fallback)
    with context.push(**extra_context):
        return tmpl.render(context)


@register.simple_tag
def build_attrs(*attrs: Any, **kwargs: Any) -> dict[str, Any]:
    """Returns a new dict of HTML attributes.

    Merges dicts left to right, then keyword arguments. Underscores in keyword
    names become hyphens. Class names are combined; other keys are replaced.
    Arguments that are not dicts (e.g. an undefined variable) are skipped.

    Example:

        {% raw %}{% build_attrs attrs hx_target="#list" class="mt-6" as attrs %}{% endraw %}
    """
    return _merge_attrs(*attrs, _keyword_attrs(kwargs))


@register.simple_tag
def merge_attrs(attrs: Any, *pairs: Any) -> str:
    """Sets key/value pairs in a dict of HTML attributes, in place.

    Keys are used as given, so they can hold names that keyword arguments
    cannot, such as ``hx-on::after-request`` or ``@click.outside``.

    Example:

        {% raw %}{% merge_attrs attrs "hx-on::after-request" "this.reset()" %}{% endraw %}
    """
    if not isinstance(attrs, dict):
        raise template.TemplateSyntaxError("merge_attrs requires a dict.")
    if len(pairs) % 2:
        raise template.TemplateSyntaxError("merge_attrs requires key/value pairs.")
    for key, value in zip(pairs[::2], pairs[1::2], strict=True):
        _set_attr(attrs, key, value)
    return ""


@register.simple_tag
def pop_attr(attrs: Any, key: str, default: Any = None) -> Any:
    """Removes a key from a dict of HTML attributes and returns its value.

    Returns ``default`` if the key is missing or ``attrs`` is not a dict.

    Example:

        {% raw %}{% pop_attr attrs "method" "post" as method %}{% endraw %}
    """
    if not isinstance(attrs, dict):
        return default
    return attrs.pop(key, default)


@register.simple_tag
def render_attrs(*attrs: Any, **defaults: Any) -> SafeString:
    """Renders dicts of HTML attributes over keyword-argument defaults.

    ``True`` renders a bare attribute; ``False`` and ``None`` are omitted.

    Example:

        {% raw %}<form {% render_attrs attrs method="post" class="space-y-4" %}>{% endraw %}
    """
    merged = _merge_attrs(_keyword_attrs(defaults), *attrs)
    if "class" in merged:
        merged["class"] = " ".join(merged["class"]) or None
    return mark_safe(flatatt(merged).lstrip())  # noqa: S308


def _keyword_attrs(kwargs: dict[str, Any]) -> dict[str, Any]:
    """Convert keyword-argument names to HTML attribute names."""
    return {key.replace("_", "-"): value for key, value in kwargs.items()}


def _merge_attrs(*attrs: Any) -> dict[str, Any]:
    """Merge dicts of HTML attributes into a new dict, skipping non-dicts."""
    merged: dict[str, Any] = {}
    for item in attrs:
        if isinstance(item, dict):
            for key, value in item.items():
                _set_attr(merged, key, value)
    return merged


def _set_attr(attrs: dict[str, Any], key: str, value: Any) -> None:
    """Set an HTML attribute, combining class names and replacing other values."""
    if key == "class":
        names = _class_names(attrs.get(key)) + _class_names(value)
        attrs[key] = list(dict.fromkeys(names))
    else:
        attrs[key] = value


def _class_names(value: Any) -> list[str]:
    """Split a class string, or list of class strings, into class names."""
    if isinstance(value, str):
        return value.split()
    if isinstance(value, list | tuple):
        return [name for item in value for name in _class_names(item)]
    return []


def _resolve_url(viewname: str, args: tuple[Any, ...], kwargs: dict[str, Any]) -> str:
    """Resolve a URL by viewname, returning empty string on failure."""
    if not viewname:
        return ""
    try:
        return reverse(viewname, args=args, kwargs=kwargs)
    except NoReverseMatch:
        return ""
