# Enable Django debug mode
DEBUG=true
# Django secret key
SECRET_KEY=django-insecure-development-only
# PostgreSQL database URL
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/postgres
# Redis URL
REDIS_URL=redis://127.0.0.1:6379/0
# Email server URL
EMAIL_URL=smtp://localhost:1025
# Host ports published by docker-compose.yml. Override to run several checkouts
# at once, and change the ports in DATABASE_URL, REDIS_URL and EMAIL_URL to match.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MAILPIT_WEB_PORT=8025
# MAILPIT_SMTP_PORT=1025
# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1
# Serve via HTTPS
USE_HTTPS=false
# Trust X-Forwarded-Host header (set true behind a reverse proxy)
USE_X_FORWARDED_HOST=false
# Enable PostgreSQL connection pooling
USE_CONNECTION_POOL=false
# Run collectstatic on startup
USE_COLLECTSTATIC=false
# Django admin URL path
ADMIN_URL=admin/

# Enable browser auto-reload on code changes (development only)
USE_BROWSER_RELOAD=true
# Enable Django Debug Toolbar (development only)
USE_DEBUG_TOOLBAR=true
# Use django-removals to scan for deprecated/removed Django features (development only)
USE_REMOVALS=true
# Use watchfiles for reloading (development only)
USE_WATCHFILES=true
# Use TranslateBot to translate .po files with an LLM (development only)
USE_TRANSLATEBOT=false
# TranslateBot LLM provider API key (development only)
# TRANSLATEBOT_API_KEY=
# TranslateBot LiteLLM model name (development only)
# TRANSLATEBOT_MODEL=anthropic/claude-sonnet-5
