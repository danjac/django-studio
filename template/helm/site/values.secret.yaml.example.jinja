# Copy this file to values.secret.yaml and fill in all values.
# values.secret.yaml is gitignored - never commit it.
#
# This file holds secrets only. Non-secret configuration (domain, admin
# addresses, meta tags, image, replicas, volume path) lives in values.yaml,
# which is committed to git.

secrets:
  postgresPassword: "CHANGE_ME"
  djangoSecretKey: "CHANGE_ME"
  djangoSecretKeyFallbacks: ""
  mailgunApiKey: ""
  # Generate with: openssl rand -hex 32
  redisPassword: "CHANGE_ME"
  sentryUrl: ""
  openTelemetryUrl: ""
  pwaSha256Fingerprints: ""
  # Object Storage - fill in after running terraform/storage and set useS3Storage: "true"
  # See docs/file-storage.md for provisioning steps.
  useS3Storage: "false"
  objectStorageAccessKey: ""
  objectStorageSecretKey: ""
  objectStorageBucket: "{{ project_slug }}-media"
  objectStorageEndpoint: "https://fsn1.your-objectstorage.com"
  objectStorageRegion: "fsn1"
  # Database backups - optional, see docs/database-backups.md and /dj-enable-db-backups
  # Provision the bucket first: just terraform backups apply
  # backupAccessKey: ""
  # backupSecretKey: ""
  # backupBucket: "{{ project_slug }}-db-backups"
  # backupEndpoint: "https://fsn1.your-objectstorage.com"
  # backupRegion: "fsn1"

  cloudflare:
    # From: terraform -chdir=terraform/cloudflare output -raw origin_cert_pem
    cert: |
      -----BEGIN CERTIFICATE-----
      CHANGE_ME
      -----END CERTIFICATE-----
    # From: terraform -chdir=terraform/cloudflare output -raw origin_key_pem
    key: |
      -----BEGIN RSA PRIVATE KEY-----
      CHANGE_ME
      -----END RSA PRIVATE KEY-----
